# Database Configuration
# For local SQLite: "file:./dev.db"
# For Supabase / Cloud PostgreSQL: "postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"
DATABASE_URL="file:./dev.db"

# Admin Authentication Secret Key
ADMIN_JWT_SECRET="your_strong_secret_key_here"
ADMIN_DEFAULT_USERNAME="admin"
ADMIN_DEFAULT_PASSWORD="your_secure_password"
